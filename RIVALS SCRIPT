-- ===== UTILIDADES =====
local function getChar(p)
	local c = p.Character
	if not c then return end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	local head = c:FindFirstChild("Head")
	if hum and root and head and hum.Health > 0 then
		return c, hum, root, head
	end
end

local function getNearestPlayer()
	local myChar, _, myRoot = getChar(player)
	if not myChar then return end
	local best, bestDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and not ignored[p] then
			local c, _, root = getChar(p)
			if c then
				local d = (root.Position - myRoot.Position).Magnitude
				if not bestDist or d < bestDist then
					best, bestDist = p, d
				end
			end
		end
	end
	return best
end

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function tween(obj, props, t)
	TweenService:Create(obj, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- Probabilidad de "fallar a propósito" del AIMBOT y del AIM (0 a 100%, 0 = nunca falla).
-- Se cambian con la barrita de cada apartado en el panel.
local aimbotMissChance = AIMBOT_MISS_CHANCE_DEFAULT
local aimMissChance = AIM_MISS_CHANCE_DEFAULT

-- Vector aleatorio para desviar la mira cuando toca "fallar": siempre se aparta de la
-- cabeza/cuerpo real entre MISS_OFFSET_MIN y MISS_OFFSET_MAX studs, en una dirección random.
local function randomMissOffset()
	local v = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
	if v.Magnitude < 0.01 then v = Vector3.new(1, 0, 0) end
	local dist = MISS_OFFSET_MIN + math.random() * (MISS_OFFSET_MAX - MISS_OFFSET_MIN)
	return v.Unit * dist
end

-- ===== AIM: CÍRCULO + AVISO AL SERVIDOR =====
local aimDiameter = AIM_CIRCLE_START
local aimPart = AIM_TARGET_PART -- "Head" o "Body" (lo cambian los botones CABEZA / CUERPO)

-- Centro del círculo: el centro de la pantalla (mira) o el mouse si lo tienes libre
local function aimCenter()
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		return camera.ViewportSize / 2
	end
	return UserInputService:GetMouseLocation()
end

local function bodyPartOf(char, root)
	return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root
end

-- ¿Se ve esa parte desde tu cámara (sin paredes en medio)?
local function isVisible(part, targetChar, myChar)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { myChar, camera }
	params.IgnoreWater = true
	local from = camera.CFrame.Position
	local r = workspace:Raycast(from, part.Position - from, params)
	return r == nil or r.Instance:IsDescendantOf(targetChar)
end

-- Enemigo más cercano al centro del círculo (dentro del círculo). Ignora a los jugadores marcados
-- como ignorados en la lista del panel. Devuelve: player, character, head, body
-- Enemigo en el que el AIM se queda "fijado": una vez que detecta a alguien dentro
-- del círculo, ignora a cualquier otro que entre después. Solo se suelta cuando ese
-- enemigo desaparece (muere / se va) o queda tapado por una pared.
local aimLockedPlayer = nil
local aimMissRolledFor = nil -- para qué jugador ya se tiró la moneda de "falla o no falla"
local aimWillMiss = false
local aimMissOffset = Vector3.zero

-- Tira la moneda UNA sola vez por cada enemigo nuevo que se fija (no en cada frame),
-- para que el "fallo" se vea como una desviación constante y no como un tembleque.
local function rollAimMiss(p)
	if aimMissRolledFor ~= p then
		aimMissRolledFor = p
		aimWillMiss = (p ~= nil) and (math.random(100) <= aimMissChance)
		aimMissOffset = aimWillMiss and randomMissOffset() or Vector3.zero
	end
end

local function getAimTarget()
	local myChar = getChar(player)
	if not myChar then
		aimLockedPlayer = nil
		return
	end

	local center = aimCenter()
	local radius = aimDiameter / 2

	-- ¿Ya hay un enemigo fijado? Nos quedamos en él pase lo que pase con los demás.
	if aimLockedPlayer then
		if ignored[aimLockedPlayer] then
			aimLockedPlayer = nil -- lo acaban de marcar como ignorado: se suelta
		else
			local c, _, root, head = getChar(aimLockedPlayer)
			if not c then
				aimLockedPlayer = nil -- murió o se fue del servidor: se suelta
			else
				local body = bodyPartOf(c, root)
				local visible = not AIM_WALLCHECK or isVisible(head, c, myChar) or isVisible(body, c, myChar)
				if not visible then
					aimLockedPlayer = nil -- quedó tapado por una pared: se suelta
				else
					rollAimMiss(aimLockedPlayer)
					return aimLockedPlayer, c, head, body
				end
			end
		end
	end

	-- Sin nadie fijado todavía: buscar al enemigo más cercano al centro del círculo
	local bestP, bestC, bestHead, bestBody, bestDist

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and not ignored[p] then
			local c, _, root, head = getChar(p)
			if c then
				local body = bodyPartOf(c, root)
				local dMin
				for _, part in ipairs({ head, body }) do
					local sp = camera:WorldToViewportPoint(part.Position)
					if sp.Z > 0 then
						local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						if not dMin or d < dMin then dMin = d end
					end
				end

				if dMin and dMin <= radius and (not bestDist or dMin < bestDist) then
					if not AIM_WALLCHECK or isVisible(head, c, myChar) or isVisible(body, c, myChar) then
						bestP, bestC, bestHead, bestBody, bestDist = p, c, head, body, dMin
					end
				end
			end
		end
	end

	aimLockedPlayer = bestP -- queda fijado desde ahora (nil si no encontró a nadie)
	rollAimMiss(aimLockedPlayer)
	return bestP, bestC, bestHead, bestBody
end

-- ¿Estás pegado o dentro de una pared? (alguna parte sólida que no sea un jugador toca tu cabeza)
local function inWall(myChar)
	local myHead = myChar:FindFirstChild("Head")
	if not myHead then return false end

	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = { myChar, camera }
	op.RespectCanCollide = true

	local parts = workspace:GetPartBoundsInRadius(myHead.Position, AIMBOT_WALL_RADIUS, op)
	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		local isPlayerPart = model and Players:GetPlayerFromCharacter(model)
		if not isPlayerPart then
			return true
		end
	end
	return false
end

-- ¿Hay una pared que bloquee el aimbot hacia esa cabeza?
--  • estás pegado/dentro de una pared
--  • hay una pared entre tu cámara y la cabeza
--  • hay una pared entre tu cabeza y la cabeza del enemigo
local function aimbotBlocked(head, targetChar, myChar)
	if AIMBOT_BLOCK_IN_WALL and inWall(myChar) then
		return true
	end
	if not AIMBOT_WALLCHECK then return false end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { myChar, camera }
	params.IgnoreWater = true
	params.RespectCanCollide = true

	-- cámara → cabeza enemiga
	local from = camera.CFrame.Position
	local r1 = workspace:Raycast(from, head.Position - from, params)
	if r1 and not r1.Instance:IsDescendantOf(targetChar) then
		return true
	end

	-- tu cabeza → cabeza enemiga
	local myHead = myChar:FindFirstChild("Head")
	if myHead then
		local from2 = myHead.Position
		local r2 = workspace:Raycast(from2, head.Position - from2, params)
		if r2 and not r2.Instance:IsDescendantOf(targetChar) then
			return true
		end
	end

	return false
end

-- Objetivo del AIMBOT: el enemigo cuya CABEZA está más cerca del CENTRO de tu pantalla.
--  • SIN límite de distancia (de lejos y de cerca)
--  • Si estás en la pared o hay una pared en medio, no devuelve a nadie → no apunta a ningún lado
--  • Ignora a los jugadores marcados como ignorados en la lista del panel
local function getAimbotTarget()
	local myChar = getChar(player)
	if not myChar then return end

	local center = camera.ViewportSize / 2
	local best, bestDist

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and not ignored[p] then
			local c, _, _, head = getChar(p)
			if c then
				-- Solo hace falta que esté DELANTE de la cámara (Z > 0). No se exige que esté dentro de la
				-- pantalla, así también funciona cuando está muy cerca y su cabeza queda fuera de cuadro.
				local sp = camera:WorldToViewportPoint(head.Position)
				if sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if (not bestDist or d < bestDist) and not aimbotBlocked(head, c, myChar) then
						best, bestDist = p, d
					end
				end
			end
		end
	end

	return best
end

-- Aviso al servidor (el servidor solo lo usa si la bala iba a fallar, y lo valida él mismo)
-- Nunca se queda esperando: si el RemoteEvent no existe, avisa una vez y sigue.
local hintRemote = nil
local hintActive = false
local lastHintSent = 0
local warnedNoRemote = false

local function sendHint(targetName, partName)
	if not hintRemote or not hintRemote.Parent then
		hintRemote = ReplicatedStorage:FindFirstChild(HINT_REMOTE_NAME)
	end
	if not hintRemote then
		if AIM_DEBUG and not warnedNoRemote then
			warnedNoRemote = true
			warn("[GUI X FREE][AIM] no encuentro el RemoteEvent '" .. HINT_REMOTE_NAME
				.. "'. Falta pegar este mismo código como Script en ServerScriptService.")
		end
		return
	end
	hintRemote:FireServer(targetName, partName)
end

local function updateAimHint(target)
	-- Si tocó "fallar" en esta fijación, no avisamos al servidor: así el disparo
	-- realmente se va a donde apunta la cámara (desviada) en vez de corregirse solo.
	if not target or aimWillMiss then
		if hintActive then
			hintActive = false
			sendHint(nil, nil) -- nadie dentro (o toca fallar): el servidor deja de hacer nada
		end
		return
	end

	local now = os.clock()
	if now - lastHintSent >= AIM_HINT_INTERVAL then
		lastHintSent = now
		hintActive = true
		local part = aimPart
		sendHint(target.Name, part)
	end
end

