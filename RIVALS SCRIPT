--[[
    GUI X FREE  (TODO EN UNO)
    Pega ESTE MISMO código en:
      • un Script       -> ServerScriptService
      • un LocalScript  -> StarterPlayer > StarterPlayerScripts

    SERVIDOR: crea los RemoteEvents, valida el AIM, hace el raycast, dibuja la bala y aplica el daño.
    CLIENTE : panel + disparo con tus Tools (manda hacia dónde apuntas).

    RightShift = mostrar/ocultar | Q = activar/desactivar AIMBOT | "–" = minimizar | "✕" = cerrar y apagar todo

    PANEL: es CUADRADO y cada cosa tiene su propio apartado (pestaña), arriba del todo:
      COMBATE (Aimbot, RageBot, TriggerBot) | AIM (círculo + tamaño + Cabeza/Cuerpo)
      VISUAL (ESP, FPS Boost) | MOVER (Noclip, Fly) | JUGADORES (lista + ignorar)
    Toca una pestaña para cambiar de apartado; lo demás sigue funcionando igual detrás.

    OPCIONES DEL PANEL:
    • AIMBOT      -> (tecla Q lo deja encendido/apagado) SIN apuntar: en cuanto ve a un enemigo (sin paredes
                     en medio) la cámara va DIRECTO a su CABEZA, de lejos y de cerca (solo cabeza, nunca el
                     cuerpo). Si estás pegado/dentro de una pared o hay una pared en medio, NO apunta a ningún
                     lado. Si prefieres que solo actúe con click derecho: AIMBOT_REQUIRE_RIGHT_CLICK = true.
                     Trae una barrita "PROBABILIDAD DE FALLAR" (0% a 100%) en el apartado COMBATE: en 0%
                     nunca falla (siempre pega en la cabeza); más alto, a veces se desvía unos studs a
                     propósito, para que no parezca tan perfecto.
    • RAGEBOT     -> TP a la espalda del más cercano, mantiene click izquierdo (disparar)
                     y click derecho (apuntar) hasta que muere; luego vuelve a tu posición
    • TRIGGER BOT -> en cuanto tu mira toca a un enemigo dispara DIRECTO (saca el arma con balas si hace falta);
                     cuando la mira se aparta del enemigo deja de disparar.
    • ESP         -> caja 2D + barra de vida
    • FPS BOOST   -> baja efectos y calidad para subir FPS
    • AIM         -> círculo ROJO ajustable. Si hay un enemigo DENTRO del círculo (y se ve, sin paredes),
                     tu cámara hace un barrido RÁPIDO y visible hasta su CABEZA o su CUERPO (lo eliges con
                     los botones CABEZA / CUERPO debajo del deslizador). El servidor redirige a esa misma
                     parte las balas que iban a fallar. Tú controlas el tiempo con AIM_SLIDE_TIME. El
                     deslizador va de 30 a 600 px. Una vez que detecta a un enemigo se queda fijo en él
                     (ignora a cualquier otro que entre al círculo) hasta que desaparece o lo tapa una pared.
                     También tiene su propia barrita "PROBABILIDAD DE FALLAR" (0% a 100%) en el apartado
                     AIM, igual que el Aimbot: en 0% nunca falla; más alto, a veces se desvía a propósito
                     (y en ese caso no le avisa al servidor, para que el disparo realmente se vaya desviado).
    • NOCLIP      -> traspasas paredes y objetos (al apagarlo vuelve la colisión normal).
    • FLY         -> vuelas: W/A/S/D se mueven hacia donde mira la cámara, ESPACIO sube, CTRL IZQ baja.
    • LISTA DE JUGADORES -> abajo del todo se ve cuántas personas hay en el servidor, con un botón
                     "IGNORAR" por cada una. Al jugador que marques como ignorado, el AIMBOT, el AIM
                     (círculo) y el RAGEBOT lo ignoran por completo (no le apuntan ni lo persiguen);
                     TriggerBot y ESP no se ven afectados por esta lista.
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HINT_REMOTE_NAME = "GUIXFREE_AimHint"
local SHOOT_REMOTE_NAME = "GUIXFREE_Shoot"

-- =====================================================================
-- ======================= PARTE DEL SERVIDOR ==========================
-- =====================================================================
if RunService:IsServer() then
	local TweenService = game:GetService("TweenService")
	local Debris = game:GetService("Debris")

	-- ===== CONFIG SERVIDOR =====
	local SERVER_ALLOWED = {
		-- [123456789] = true,  -- pon tu UserId y el de tus testers
	}
	local ALLOW_IN_STUDIO = true   -- en Studio lo puede usar cualquiera que pruebe
	local HINT_TTL = 0.4           -- segundos que vale un aviso del panel
	local MAX_RANGE = 500          -- alcance máximo de la bala
	local MAX_ANGLE_DEG = 30       -- el objetivo debe estar a menos de este ángulo de donde apuntaste
	local DAMAGE = 25
	local HEADSHOT_MULT = 2
	local FIRE_RATE = 0.08         -- mínimo entre disparos (anti-spam)
	local BULLET_SPEED = 700       -- studs/seg (visual)
	local TRACER_LENGTH = 10       -- largo de la bala que se ve (rápida y alargada)
	local TRACER_COLOR = Color3.fromRGB(255, 220, 120)

	local function getOrCreateRemote(name)
		local r = ReplicatedStorage:FindFirstChild(name)
		if not r then
			r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = ReplicatedStorage
		end
		return r
	end

	local hintRemote = getOrCreateRemote(HINT_REMOTE_NAME)
	local shootRemote = getOrCreateRemote(SHOOT_REMOTE_NAME)

	local hints = {}
	local lastShot = {}

	local function isAllowed(plr)
		return SERVER_ALLOWED[plr.UserId] == true or (ALLOW_IN_STUDIO and RunService:IsStudio())
	end

	-- Aviso del panel: "este es el enemigo dentro del círculo y esta es la parte"
	hintRemote.OnServerEvent:Connect(function(plr, targetName, partName)
		if not isAllowed(plr) then return end

		if targetName == nil then
			hints[plr] = nil -- nadie dentro del círculo: no hacer nada
			return
		end
		if typeof(targetName) ~= "string" or (partName ~= "Head" and partName ~= "Body") then return end

		local target = Players:FindFirstChild(targetName)
		if target and target:IsA("Player") and target ~= plr then
			hints[plr] = { target = target, part = partName, t = os.clock() }
		end
	end)

	Players.PlayerRemoving:Connect(function(plr)
		hints[plr] = nil
		lastShot[plr] = nil
	end)

	local function playerFromHit(inst)
		local model = inst and inst:FindFirstAncestorOfClass("Model")
		return model and Players:GetPlayerFromCharacter(model)
	end

	-- Devuelve la dirección final del disparo. Solo cambia algo si la bala iba a FALLAR.
	local function resolveAim(plr, origin, direction, params)
		direction = direction.Unit

		-- 1) Si la bala ya iba a darle a un jugador, no se toca
		local straight = workspace:Raycast(origin, direction * MAX_RANGE, params)
		if straight and playerFromHit(straight.Instance) then
			return direction
		end

		-- 2) ¿Hay un aviso vigente del panel?
		local h = hints[plr]
		if not h or os.clock() - h.t > HINT_TTL then return direction end

		-- 3) El objetivo tiene que seguir vivo (si murió o se fue, no hace nada)
		local char = h.target.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (hum and hum.Health > 0) then
			hints[plr] = nil
			return direction
		end

		local part
		if h.part == "Head" then
			part = char:FindFirstChild("Head")
		end
		part = part or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
		if not part then return direction end

		-- 4) Distancia y ángulo (el "círculo" validado por el servidor)
		local toPart = part.Position - origin
		if toPart.Magnitude > MAX_RANGE or toPart.Magnitude < 0.1 then return direction end
		local angle = math.deg(math.acos(math.clamp(direction:Dot(toPart.Unit), -1, 1)))
		if angle > MAX_ANGLE_DEG then return direction end

		-- 5) Línea de visión comprobada por el servidor
		local los = workspace:Raycast(origin, toPart, params)
		if los and not los.Instance:IsDescendantOf(char) then return direction end

		return toPart.Unit
	end

	-- Disparo: el cliente solo manda hacia dónde apuntas
	shootRemote.OnServerEvent:Connect(function(plr, aimDirection)
		if typeof(aimDirection) ~= "Vector3" or aimDirection.Magnitude < 0.01 then return end

		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local head = char and char:FindFirstChild("Head")
		if not (hum and head and hum.Health > 0) then return end
		if not char:FindFirstChildOfClass("Tool") then return end -- solo si tiene un arma en la mano

		local now = os.clock()
		if lastShot[plr] and now - lastShot[plr] < FIRE_RATE then return end
		lastShot[plr] = now

		local origin = head.Position
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		params.IgnoreWater = true

		local direction = resolveAim(plr, origin, aimDirection, params)

		local result = workspace:Raycast(origin, direction * MAX_RANGE, params)
		local hitPos = result and result.Position or (origin + direction * MAX_RANGE)

		-- Bala visual rápida y alargada
		local dist = (hitPos - origin).Magnitude
		local base = CFrame.lookAt(origin, hitPos)
		local tracer = Instance.new("Part")
		tracer.Anchored = true
		tracer.CanCollide = false
		tracer.CanQuery = false
		tracer.CanTouch = false
		tracer.Material = Enum.Material.Neon
		tracer.Color = TRACER_COLOR
		tracer.Size = Vector3.new(0.12, 0.12, TRACER_LENGTH)
		tracer.CFrame = base * CFrame.new(0, 0, -TRACER_LENGTH / 2)
		tracer.Parent = workspace
		local travel = math.max(dist / BULLET_SPEED, 0.02)
		TweenService:Create(tracer, TweenInfo.new(travel, Enum.EasingStyle.Linear),
			{ CFrame = base * CFrame.new(0, 0, -(dist + TRACER_LENGTH / 2)) }):Play()
		Debris:AddItem(tracer, travel + 0.05)

		-- Daño (lo calcula el servidor)
		if result then
			local victimChar = result.Instance:FindFirstAncestorOfClass("Model")
			local victimHum = victimChar and victimChar:FindFirstChildOfClass("Humanoid")
			if victimHum and victimHum.Health > 0 and victimChar ~= char then
				victimHum:TakeDamage(result.Instance.Name == "Head" and DAMAGE * HEADSHOT_MULT or DAMAGE)
			end
		end
	end)

	print("[GUI X FREE] servidor listo")
	return -- fin de la parte del servidor
end

