local aimHeld = false     -- click derecho (apuntar)

-- Manda un click real (button: 0 = izquierdo, 1 = derecho). Devuelve true si funcionó.
local function vimButton(button, down)
	if not (RAGE_USE_VIM and VIM) or vimWorks == false then return false end
	local c = camera.ViewportSize / 2
	local ok = pcall(function()
		VIM:SendMouseButtonEvent(c.X, c.Y, button, down, game, 0)
	end)
	if ok then
		if vimWorks == nil then
			vimWorks = true
			print("[GUI X FREE][RageBot] clicks reales (VirtualInputManager): OK")
		end
	else
		vimWorks = false
		print("[GUI X FREE][RageBot] VirtualInputManager bloqueado. Uso Tool:Activate() y los atributos "
			.. RAGE_FIRE_ATTRIBUTE .. " / " .. RAGE_AIM_ATTRIBUTE .. ".")
	end
	return ok
end

-- Click IZQUIERDO mantenido (disparar)
local function holdFire(on)
	player:SetAttribute(RAGE_FIRE_ATTRIBUTE, on)
	if on ~= mouseHeld then
		vimButton(0, on)
	end
	mouseHeld = on

	if not on then
		if heldTool then
			pcall(function() heldTool:Deactivate() end)
			heldTool = nil
		end
		local ch = player.Character
		local t = ch and ch:FindFirstChildOfClass("Tool")
		if t then pcall(function() t:Deactivate() end) end
	end
end

-- Click DERECHO mantenido (apuntar)
local function holdAim(on)
	player:SetAttribute(RAGE_AIM_ATTRIBUTE, on)
	if on ~= aimHeld then
		vimButton(1, on)
	end
	aimHeld = on
end

-- ===== FPS BOOST =====
local fpsParts = setmetatable({}, { __mode = "k" })
local fpsEffects = setmetatable({}, { __mode = "k" })
local fpsLighting = nil
local fpsWater = nil
local fpsQuality = nil
local fpsAddedConn = nil
local fpsToken = 0

local EFFECT_CLASSES = { "ParticleEmitter", "Trail", "Beam", "Smoke", "Fire", "Sparkles", "PostEffect" }

local function isEffect(inst)
	for _, cls in ipairs(EFFECT_CLASSES) do
		if inst:IsA(cls) then return true end
	end
	return false
end

local function boostInstance(inst)
	if inst:IsA("BasePart") and not inst:IsA("Terrain") then
		if not fpsParts[inst] then
			fpsParts[inst] = { inst.Material, inst.Reflectance, inst.CastShadow }
		end
		inst.Material = Enum.Material.SmoothPlastic
		inst.Reflectance = 0
		inst.CastShadow = false
	elseif isEffect(inst) then
		if fpsEffects[inst] == nil then
			fpsEffects[inst] = inst.Enabled
		end
		inst.Enabled = false
	end
end

local function setFPSBoost(enabled)
	fpsToken += 1
	local myToken = fpsToken

	if enabled then
		if not fpsLighting then
			fpsLighting = { GlobalShadows = Lighting.GlobalShadows }
		end
		Lighting.GlobalShadows = false

		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain and not fpsWater then
			fpsWater = {
				WaterWaveSize = terrain.WaterWaveSize,
				WaterWaveSpeed = terrain.WaterWaveSpeed,
				WaterReflectance = terrain.WaterReflectance,
			}
		end
		if terrain then
			pcall(function()
				terrain.WaterWaveSize = 0
				terrain.WaterWaveSpeed = 0
				terrain.WaterReflectance = 0
			end)
		end

		pcall(function()
			local rendering = settings().Rendering
			if fpsQuality == nil then fpsQuality = rendering.QualityLevel end
			rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		for _, inst in ipairs(Lighting:GetDescendants()) do
			if isEffect(inst) then boostInstance(inst) end
		end

		task.spawn(function()
			local count = 0
			for _, inst in ipairs(workspace:GetDescendants()) do
				if myToken ~= fpsToken then return end
				boostInstance(inst)
				count += 1
				if count % 400 == 0 then task.wait() end
			end
		end)

		if fpsAddedConn then fpsAddedConn:Disconnect() end
		fpsAddedConn = workspace.DescendantAdded:Connect(function(inst)
			if state.FPSBoost then boostInstance(inst) end
		end)
	else
		if fpsAddedConn then
			fpsAddedConn:Disconnect()
			fpsAddedConn = nil
		end

		if fpsLighting then
			Lighting.GlobalShadows = fpsLighting.GlobalShadows
			fpsLighting = nil
		end

		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain and fpsWater then
			pcall(function()
				terrain.WaterWaveSize = fpsWater.WaterWaveSize
				terrain.WaterWaveSpeed = fpsWater.WaterWaveSpeed
				terrain.WaterReflectance = fpsWater.WaterReflectance
			end)
		end
		fpsWater = nil

		if fpsQuality ~= nil then
			pcall(function() settings().Rendering.QualityLevel = fpsQuality end)
			fpsQuality = nil
		end

		task.spawn(function()
			local count = 0
			for inst, data in pairs(fpsParts) do
				if myToken ~= fpsToken then return end
				if inst.Parent then
					inst.Material = data[1]
					inst.Reflectance = data[2]
					inst.CastShadow = data[3]
				end
				fpsParts[inst] = nil
				count += 1
				if count % 400 == 0 then task.wait() end
			end
			for inst, was in pairs(fpsEffects) do
				if myToken ~= fpsToken then return end
				if inst.Parent then inst.Enabled = was end
				fpsEffects[inst] = nil
			end
		end)
	end
end

-- ===== MUNICIÓN / ARMAS =====
local function matchesAmmo(name)
	local l = string.lower(name)
	for _, ex in ipairs(AMMO_EXCLUDE) do
		if l:find(ex, 1, true) then return false end
	end
	if l == "mag" or l == "mags" then return true end
	for _, k in ipairs(AMMO_KEYWORDS) do
		if l:find(k, 1, true) then return true end
	end
	return false
end

-- Devuelve (cantidad, nombreDondeLaEncontró) o nil si no la encuentra
local function getAmmo(tool)
	if AMMO_NAME then
		local a = tool:GetAttribute(AMMO_NAME)
		if typeof(a) == "number" then return a, AMMO_NAME end
		local v = tool:FindFirstChild(AMMO_NAME, true)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then return v.Value, AMMO_NAME end
		local ownerChar = tool.Parent
		if ownerChar then
			local pv = ownerChar:FindFirstChild(AMMO_NAME, true)
			if pv and (pv:IsA("NumberValue") or pv:IsA("IntValue")) then return pv.Value, AMMO_NAME end
		end
		return nil
	end

	for name, val in pairs(tool:GetAttributes()) do
		if typeof(val) == "number" and matchesAmmo(name) then
			return val, name
		end
	end

	for _, d in ipairs(tool:GetDescendants()) do
		if (d:IsA("NumberValue") or d:IsA("IntValue")) and matchesAmmo(d.Name) then
			return d.Value, d.Name
		end
		for name, val in pairs(d:GetAttributes()) do
			if typeof(val) == "number" and matchesAmmo(name) then
				return val, d.Name .. "." .. name
			end
		end
	end

	return nil
end

local debugged = setmetatable({}, { __mode = "k" })
local function debugTool(tool)
	if not AMMO_DEBUG or debugged[tool] then return end
	debugged[tool] = true

	local ammo, where = getAmmo(tool)
	if ammo ~= nil then
		print(("[GUI X FREE] Arma '%s': munición detectada en '%s' = %s"):format(tool.Name, where, tostring(ammo)))
		return
	end

	local lines = {}
	for name, val in pairs(tool:GetAttributes()) do
		table.insert(lines, ("  atributo %s = %s"):format(name, tostring(val)))
	end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("NumberValue") or d:IsA("IntValue") or d:IsA("StringValue") then
			table.insert(lines, ("  valor %s (%s) = %s"):format(d:GetFullName(), d.ClassName, tostring(d.Value)))
		end
	end
	warn(("[GUI X FREE] No encontré munición en '%s'. Esto es lo que tiene:\n%s\n"
		.. "Dime cuál es la de balas, o ponla en AMMO_NAME."):format(
		tool.Name, #lines > 0 and table.concat(lines, "\n") or "  (sin atributos ni valores)"))
end

local toolOrder = setmetatable({}, { __mode = "k" })
local nextOrder = 0

local function getTools(char)
	local list = {}
	for _, t in ipairs(player.Backpack:GetChildren()) do
		if t:IsA("Tool") then table.insert(list, t) end
	end
	local eq = char:FindFirstChildOfClass("Tool")
	if eq then table.insert(list, eq) end

	for _, t in ipairs(list) do
		if not toolOrder[t] then
			nextOrder += 1
			toolOrder[t] = nextOrder
		end
	end

	local function rank(t)
		for i, n in ipairs(WEAPON_ORDER) do
			if t.Name == n then return i end
		end
		return #WEAPON_ORDER + 1
	end

	table.sort(list, function(a, b)
		local ra, rb = rank(a), rank(b)
		if ra ~= rb then return ra < rb end
		return toolOrder[a] < toolOrder[b]
	end)
	return list
end

-- Primera arma con balas. Si ninguna tiene (o no se detecta la munición),
-- usa la que tengas en la mano o, si no, la primera del inventario.
local function pickWeapon(char)
	local tools = getTools(char)
	for _, t in ipairs(tools) do
		debugTool(t)
		local ammo = getAmmo(t)
		if ammo == nil or ammo > 0 then
			return t
		end
	end
	return char:FindFirstChildOfClass("Tool") or tools[1]
end

