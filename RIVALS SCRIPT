	if not ch then return end
	for _, p in ipairs(ch:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = false end
	end
end)

-- ===== AIMBOT / RAGEBOT: CÁMARA + CUERPO =====
-- Prioridades: personaje (+1) → cámara (200) → aimbot (+1) → tus manos (+2) → brazos del aimbot (+3)
local AIM_PRIORITY = Enum.RenderPriority.Camera.Value + 1
local ARMS_PRIORITY = Enum.RenderPriority.Camera.Value + 3
local autoRotateBackup = nil
local aimTargetHead = nil

RunService:BindToRenderStep("GUIXFREE_Aimbot", AIM_PRIORITY, function()
	local myChar, myHum, myRoot = getChar(player)
	local active = state.Aimbot or state.RageBot

	if not active then
		aimTargetHead = nil
		if autoRotateBackup ~= nil and myHum then
			myHum.AutoRotate = autoRotateBackup
			autoRotateBackup = nil
		end
		return
	end
	if not myChar then aimTargetHead = nil return end

	-- El RageBot apunta a su objetivo fijo; el Aimbot normal al más cercano
	local target
	if state.RageBot then
		target = rageTarget
	else
		target = getNearestPlayer()
	end
	if not target then aimTargetHead = nil return end

	local _, _, _, tHead = getChar(target)
	if not tHead then aimTargetHead = nil return end

	if autoRotateBackup == nil then
		autoRotateBackup = myHum.AutoRotate
	end
	myHum.AutoRotate = false

	-- La cámara apunta solo a la cabeza
	camera.CFrame = CFrame.lookAt(camera.CFrame.Position, tHead.Position)

	-- El cuerpo gira hacia el objetivo (horizontal)
	local flat = Vector3.new(tHead.Position.X, myRoot.Position.Y, tHead.Position.Z)
	myRoot.CFrame = CFrame.lookAt(myRoot.Position, flat)

	aimTargetHead = tHead
end)

-- ===== BRAZOS / MANOS APUNTAN A LA CABEZA =====
local armState = {}

local function findShoulders(char)
	local list = {}
	local rUA = char:FindFirstChild("RightUpperArm")
	local lUA = char:FindFirstChild("LeftUpperArm")
	if rUA and lUA then -- R15
		local r = rUA:FindFirstChild("RightShoulder")
		local l = lUA:FindFirstChild("LeftShoulder")
		if r then table.insert(list, { joint = r, r6 = false, sign = 1 }) end
		if l then table.insert(list, { joint = l, r6 = false, sign = 1 }) end
	else -- R6
		local torso = char:FindFirstChild("Torso")
		if torso then
			local r = torso:FindFirstChild("Right Shoulder")
			local l = torso:FindFirstChild("Left Shoulder")
			if r then table.insert(list, { joint = r, r6 = true, sign = 1 }) end
			if l then table.insert(list, { joint = l, r6 = true, sign = -1 }) end
		end
	end
	return list
end

local function applyArmPitch(char, pitch)
	for _, info in ipairs(findShoulders(char)) do
		local j = info.joint
		local st = armState[j]
		if not st then
			st = {}
			armState[j] = st
		end
		if st.last == nil or j.C0 ~= st.last then
			st.orig = j.C0
		end
		local rot
		if info.r6 then
			rot = CFrame.Angles(0, 0, pitch * info.sign)
		else
			rot = CFrame.Angles(pitch, 0, 0)
		end
		local new = st.orig * rot
		j.C0 = new
		st.last = new
	end
end

local function restoreArms()
	for j, st in pairs(armState) do
		if j.Parent and st.orig and st.last and j.C0 == st.last then
			j.C0 = st.orig
		end
		armState[j] = nil
	end
end

RunService:BindToRenderStep("GUIXFREE_AimArms", ARMS_PRIORITY, function()
	local active = state.Aimbot or state.RageBot
	if not ARMS_AIM or not active or not aimTargetHead then
		if next(armState) ~= nil then restoreArms() end
		return
	end
	local myChar = getChar(player)
	if not myChar then return end

	local dir = (aimTargetHead.Position - camera.CFrame.Position)
	if dir.Magnitude < 0.01 then return end
	dir = dir.Unit
	local pitch = math.asin(math.clamp(dir.Y, -1, 1)) * ARM_PITCH_MULT + ARM_PITCH_OFFSET

	applyArmPitch(myChar, pitch)
end)

-- ===== RAGEBOT =====
-- 1) Guarda tu posición y se pega a la espalda del enemigo más cercano
-- 2) Saca el arma con balas y deja apretado el click IZQUIERDO (disparar)
--    y el click DERECHO (apuntar)
-- 3) Cuando el enemigo muere: suelta ambos clicks y vuelve a tu posición original
-- 4) Espera RAGE_NEXT_DELAY y pasa al siguiente
rageStop = function(goHome)
	holdFire(false)
	holdAim(false)
	local _, _, myRoot = getChar(player)
	if goHome and rageOrigin and myRoot then
		myRoot.CFrame = rageOrigin
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
	end
	rageOrigin = nil
	rageTarget = nil
	rageCooldownUntil = os.clock() + RAGE_NEXT_DELAY
end

local lastRageActivate = 0
local lastRageEquip = 0
local fireDebugged = setmetatable({}, { __mode = "k" })

local function debugFire(tool)
	if fireDebugged[tool] then return end
	fireDebugged[tool] = true

	local names = {}
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("LocalScript") or d:IsA("Script") or d:IsA("RemoteEvent")
			or d:IsA("RemoteFunction") or d:IsA("BindableEvent") then
			table.insert(names, d.ClassName .. ": " .. d.Name)
		end
	end
	print(("[GUI X FREE][RageBot] disparando con '%s' (modo '%s'). Contiene: %s"):format(
		tool.Name, RAGE_FIRE_MODE, #names > 0 and table.concat(names, ", ") or "nada"))

	if not tool.Enabled then
		warn("[GUI X FREE][RageBot] '" .. tool.Name .. "' tiene Enabled = false: Activate() no hará nada.")
	end
	if tool.ManualActivationOnly then
		warn("[GUI X FREE][RageBot] '" .. tool.Name .. "' tiene ManualActivationOnly = true: Activate() no hará nada.")
	end
end

connect(RunService.Heartbeat, function()
	if not state.RageBot then return end

	local myChar, myHum, myRoot = getChar(player)
	if not myChar then
		-- Si tú moriste, cancelar todo (no hay a dónde volver)
		if rageTarget or mouseHeld or aimHeld then
			rageOrigin = nil
			rageStop(false)
		end
		return
	end

	if os.clock() < rageCooldownUntil then return end

	-- ¿Murió el objetivo? → soltar ambos clicks y volver a tu sitio
	if rageTarget and not (rageTarget.Parent and getChar(rageTarget)) then
		print("[GUI X FREE][RageBot] objetivo eliminado → suelto clicks y vuelvo a mi posición")
		rageStop(true)
		return
	end

	-- Elegir objetivo nuevo y recordar de dónde sales
	if not rageTarget then
		rageTarget = getNearestPlayer()
		if not rageTarget then return end
		rageOrigin = myRoot.CFrame
		print("[GUI X FREE][RageBot] objetivo: " .. rageTarget.Name)
	end

	-- Pegarse a la espalda (otra vez, después de la física)
	stickBehind()

	-- Sacar el arma (arma 1 → arma 2 si se queda sin balas)
	local tool = pickWeapon(myChar)
	if not tool then return end

	-- Cambiando de arma: soltar clicks y volver a apretarlos con la nueva
	if tool.Parent ~= myChar then
		if mouseHeld then holdFire(false) end
		if aimHeld then holdAim(false) end
		if os.clock() - lastRageEquip > 0.05 then
			lastRageEquip = os.clock()
			myHum:EquipTool(tool)
		end
		return
	end

	debugFire(tool)

	-- Click DERECHO apretado (apuntar) y luego click IZQUIERDO apretado (disparar)
	if RAGE_AIM_RIGHT_CLICK and not aimHeld then
		holdAim(true)
	end
	if not mouseHeld then
		holdFire(true)
	end

	-- Refuerzo con Tool:Activate() para armas que usan Tool.Activated
	if RAGE_FIRE_MODE == "hold" then
		if heldTool ~= tool then
			if heldTool then pcall(function() heldTool:Deactivate() end) end
			pcall(function() tool:Activate() end)
			heldTool = tool
		end
	else
		if os.clock() - lastRageActivate >= RAGE_FIRE_INTERVAL then
			lastRageActivate = os.clock()
			pcall(function() tool:Activate() end)
			task.defer(function()
				if tool.Parent then pcall(function() tool:Deactivate() end) end
			end)
		end
	end
end)

-- ===== TRIGGER BOT =====
-- • Detecta si apuntas a un jugador (ignora tu cámara, manos y arma)
-- • Saca el arma con balas (arma 1 → arma 2) y dispara
-- • Si falla, dice por qué en el Output
local lastSwitch = 0
local lastDbgMsg, lastDbgTime = "", 0

local function dbg(msg)
	if not TRIGGER_DEBUG then return end
	if msg ~= lastDbgMsg or os.clock() - lastDbgTime > 3 then
		lastDbgMsg = msg
		lastDbgTime = os.clock()
		print("[GUI X FREE][TriggerBot] " .. msg)
	end
end

local function getAimedPlayer(myChar)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { myChar, camera }
	params.IgnoreWater = true

	local pos
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		pos = camera.ViewportSize / 2
	else
		pos = UserInputService:GetMouseLocation()
	end

	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	local result = workspace:Raycast(ray.Origin, ray.Direction * TRIGGER_RANGE, params)
	if not result then
		return nil, "el rayo no golpea nada"
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and result.Instance:IsDescendantOf(p.Character) then
			return p
		end
	end
	return nil, "apuntas a '" .. result.Instance:GetFullName() .. "' (no es un jugador)"
end

connect(RunService.Heartbeat, function()
	if not state.TriggerBot then return end
	local myChar, myHum = getChar(player)
	if not myChar then
		dbg("tu personaje no está vivo")
		return
	end

	-- 1) Cambio automático al quedarse sin balas
	local equipped = myChar:FindFirstChildOfClass("Tool")
	if equipped then
		debugTool(equipped)
		local ammo = getAmmo(equipped)
		if ammo ~= nil and ammo <= 0 and os.clock() - lastSwitch > 0.15 then
			local nextTool = pickWeapon(myChar)
			if nextTool and nextTool ~= equipped then
				lastSwitch = os.clock()
				dbg("sin balas en '" .. equipped.Name .. "', cambio a '" .. nextTool.Name .. "'")
				myHum:EquipTool(nextTool)
			end
		end
	end

	-- 2) ¿Estoy apuntando a un jugador vivo?
	local target, why = getAimedPlayer(myChar)
	if not target then
		dbg("sin objetivo: " .. tostring(why))
		return
	end
	if not getChar(target) then
		dbg(target.Name .. " ya está muerto")
		return
	end

	-- 3) Sacar el arma correcta y disparar
	local tool = pickWeapon(myChar)
	if not tool then
		dbg("no encontré ninguna Tool en tu Backpack ni en la mano (¿tu arma es una Tool?)")
		return
	end

	if tool.Parent ~= myChar then
		if os.clock() - lastSwitch > 0.05 then
			lastSwitch = os.clock()
			dbg("sacando '" .. tool.Name .. "'")
			myHum:EquipTool(tool)
		end
		return
	end

	dbg("disparando a " .. target.Name .. " con '" .. tool.Name .. "'")
	tool:Activate()
end)

-- ===== ESP (caja 2D + barra de vida) =====
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP"
espFolder.Parent = gui

local espObjects = {}

local function createESP(p)
	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Visible = false
	box.Parent = espFolder
	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = Color3.fromRGB(255, 255, 255)
	boxStroke.Thickness = 1.5
	boxStroke.Parent = box

	local barBg = Instance.new("Frame")
	barBg.BackgroundColor3 = Color3.new(0, 0, 0)
	barBg.BorderSizePixel = 0
	barBg.Visible = false
	barBg.Parent = espFolder

	local bar = Instance.new("Frame")
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0, 1)
	bar.Parent = barBg

	local hpText = Instance.new("TextLabel")
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0
	hpText.Font = Enum.Font.GothamBold
	hpText.TextSize = 12
	hpText.Visible = false
	hpText.Parent = espFolder

	espObjects[p] = { box = box, barBg = barBg, bar = bar, hpText = hpText }
end

local function removeESP(p)
	local o = espObjects[p]
	if o then
		o.box:Destroy()
		o.barBg:Destroy()
		o.hpText:Destroy()
		espObjects[p] = nil
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= player then createESP(p) end
end
connect(Players.PlayerAdded, function(p)
	if p ~= player then createESP(p) end
end)
connect(Players.PlayerRemoving, removeESP)

connect(RunService.RenderStepped, function()
	for p, o in pairs(espObjects) do
		local visible = false
		if state.ESP then
			local c, hum, root = getChar(p)
			if c then
				local topPos, onTop = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
				local botPos = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.5, 0))
				if onTop and topPos.Z > 0 then
					visible = true
					local h = math.abs(botPos.Y - topPos.Y)
					local w = h / 1.8
					local cx = topPos.X
					local top = topPos.Y

					o.box.Size = UDim2.fromOffset(w, h)
					o.box.Position = UDim2.fromOffset(cx - w / 2, top)

					local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
					o.barBg.Size = UDim2.fromOffset(4, h)
					o.barBg.Position = UDim2.fromOffset(cx - w / 2 - 7, top)
					o.bar.Size = UDim2.new(1, 0, hpPct, 0)
					o.bar.Position = UDim2.new(0, 0, 1, 0)
					o.bar.BackgroundColor3 = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), hpPct)

					o.hpText.Text = tostring(math.floor(hum.Health))
					o.hpText.Size = UDim2.fromOffset(40, 14)
					o.hpText.Position = UDim2.fromOffset(cx - w / 2 - 42, top + h / 2 - 7)
				end
			end
		end
		o.box.Visible = visible
		o.barBg.Visible = visible
		o.hpText.Visible = visible
	end
end)

