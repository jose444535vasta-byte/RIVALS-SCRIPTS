-- ===== RAGEBOT: PEGARSE A LA ESPALDA =====
-- Se ejecuta en cada frame y otra vez tras la física, con la velocidad en 0
-- para que nada te empuje fuera de su espalda.
local function stickBehind()
	if not state.RageBot or not rageTarget then return end
	local _, _, myRoot = getChar(player)
	local _, _, tRoot = getChar(rageTarget)
	if not myRoot or not tRoot then return end

	-- "Detrás" según hacia dónde mira el enemigo, a su misma altura
	local look = Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
	if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
	look = look.Unit

	local pos = tRoot.Position - look * BEHIND_DISTANCE
	local lookAt = Vector3.new(tRoot.Position.X, pos.Y, tRoot.Position.Z)

	myRoot.CFrame = CFrame.lookAt(pos, lookAt)
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero
end

RunService:BindToRenderStep("GUIXFREE_RageStick", Enum.RenderPriority.Character.Value + 1, stickBehind)

-- Sin colisión mientras persigues (para no ser empujado)
connect(RunService.Stepped, function()
	if not (RAGE_NOCLIP and state.RageBot and rageTarget) then return end
	local ch = player.Character
	if not ch then return end
	for _, p in ipairs(ch:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = false end
	end
end)

-- ===== AIMBOT / RAGEBOT: CÁMARA + CUERPO =====
-- Prioridades: personaje (+1) → cámara (200) → aimbot (+1) → deslizamiento AIM (+2) → tus manos / brazos (+3)
local AIM_PRIORITY = Enum.RenderPriority.Camera.Value + 1
local SLIDE_PRIORITY = Enum.RenderPriority.Camera.Value + 2
local ARMS_PRIORITY = Enum.RenderPriority.Camera.Value + 3
local autoRotateBackup = nil
local aimTargetHead = nil

-- Probabilidad de "fallar a propósito" del AIMBOT (barrita en el apartado COMBATE).
-- Se tira la moneda una sola vez por cada enemigo nuevo, no en cada frame.
local aimbotMissRolledFor = nil
local aimbotWillMiss = false
local aimbotMissOffsetVec = Vector3.zero

local function rollAimbotMiss(p)
	if aimbotMissRolledFor ~= p then
		aimbotMissRolledFor = p
		aimbotWillMiss = (p ~= nil) and (math.random(100) <= aimbotMissChance)
		aimbotMissOffsetVec = aimbotWillMiss and randomMissOffset() or Vector3.zero
	end
end

-- ¿Estás manteniendo el click derecho (apuntar)?
local function rightClickHeld()
	return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

-- ¿Debe actuar ahora el aimbot?
--  • RageBot: siempre que esté encendido
--  • Aimbot: encendido (Q / panel) Y, si AIMBOT_REQUIRE_RIGHT_CLICK = true, con el click derecho apretado
local function aimbotWants()
	if state.RageBot then return true end
	if not state.Aimbot then return false end
	if AIMBOT_REQUIRE_RIGHT_CLICK then
		return rightClickHeld()
	end
	return true
end

RunService:BindToRenderStep("GUIXFREE_Aimbot", AIM_PRIORITY, function()
	local myChar, myHum, myRoot = getChar(player)
	local active = aimbotWants()

	if not active then
		-- Soltaste el click derecho (o está apagado): devolver el control normal
		aimTargetHead = nil
		if autoRotateBackup ~= nil and myHum then
			myHum.AutoRotate = autoRotateBackup
			autoRotateBackup = nil
		end
		return
	end
	if not myChar then aimTargetHead = nil return end

	-- El RageBot apunta a su objetivo fijo (sin filtrar por ignorados); el Aimbot al enemigo más cercano
	-- a tu mira, filtrando ignorados. Si estás en la pared (o hay una pared en medio),
	-- getAimbotTarget() devuelve nil → no apunta a ningún lado.
	local target
	if state.RageBot then
		target = rageTarget
	else
		target = getAimbotTarget()
	end

	local tHead
	if target then
		local _, _, _, h = getChar(target)
		tHead = h
	end

	-- Sin objetivo: soltar el control y devolver el giro normal
	if not tHead then
		aimTargetHead = nil
		if autoRotateBackup ~= nil then
			myHum.AutoRotate = autoRotateBackup
			autoRotateBackup = nil
		end
		return
	end

	-- Evita errores cuando la cabeza está exactamente encima de la cámara
	if (tHead.Position - camera.CFrame.Position).Magnitude < 0.1 then
		aimTargetHead = nil
		return
	end

	if autoRotateBackup == nil then
		autoRotateBackup = myHum.AutoRotate
	end
	myHum.AutoRotate = false

	-- Si es el AIMBOT (no el RageBot) el que controla, aplica la barrita de "probabilidad
	-- de fallar": en 0% siempre pega en la cabeza; más alto, a veces se desvía unos studs.
	local aimPoint = tHead.Position
	if not state.RageBot then
		rollAimbotMiss(target)
		if aimbotWillMiss then
			aimPoint = tHead.Position + aimbotMissOffsetVec
		end
	end

	-- La cámara apunta DIRECTO a la CABEZA (de lejos y de cerca), salvo que haya tocado fallar
	camera.CFrame = CFrame.lookAt(camera.CFrame.Position, aimPoint)

	-- El cuerpo gira hacia el objetivo (horizontal)
	local flat = Vector3.new(tHead.Position.X, myRoot.Position.Y, tHead.Position.Z)
	if (flat - myRoot.Position).Magnitude > 0.05 then
		myRoot.CFrame = CFrame.lookAt(myRoot.Position, flat)
	end

	aimTargetHead = tHead
end)

-- ===== AIM: LA CÁMARA SE DESLIZA RÁPIDO A LA CABEZA DENTRO DEL CÍRCULO ROJO =====
-- • Solo actúa si el botón AIM está encendido y hay un enemigo DENTRO del círculo (y se ve)
-- • Va a la CABEZA o al CUERPO según el botón elegido, con un barrido rápido y visible (AIM_SLIDE_TIME)
-- • Si el AIMBOT (Q + click derecho) o el RageBot están actuando, esos mandan y el deslizamiento espera
-- • getAimTarget() ya ignora a los jugadores marcados como ignorados en la lista del panel
local slideProgress = 0 -- 0 = recién detectado, 1 = ya está sobre la cabeza

RunService:BindToRenderStep("GUIXFREE_AimSlide", SLIDE_PRIORITY, function(dt)
	if not state.AIM or aimbotWants()
		or (AIM_SLIDE_REQUIRES_CLICK
			and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) then
		slideProgress = 0
		return
	end

	local _, _, headPart, bodyPart = getAimTarget()
	local part = (aimPart == "Head") and headPart or bodyPart
	if not part then
		slideProgress = 0 -- nadie dentro del círculo: no hace nada y reinicia
		return
	end

	-- Si tocó "fallar" (barrita AIM: PROBABILIDAD DE FALLAR), el barrido se desvía
	-- unos studs en vez de ir exacto a la cabeza/cuerpo.
	local aimPoint = part.Position + (aimWillMiss and aimMissOffset or Vector3.zero)

	local cf = camera.CFrame
	if (aimPoint - cf.Position).Magnitude < 0.1 then return end

	-- El progreso sube de 0 a 1 en AIM_SLIDE_TIME segundos (independiente de los FPS).
	-- La cámara base la reescribe el juego cada frame, por eso el avance se guarda aquí
	-- y no en la cámara: así el barrido se ve completo y rápido, no un empujoncito.
	slideProgress = math.min(1, slideProgress + dt / math.max(AIM_SLIDE_TIME, 0.01))
	local eased = 1 - (1 - slideProgress) ^ 3 -- arranca fuerte y frena al llegar

	local goal = CFrame.lookAt(cf.Position, aimPoint)
	camera.CFrame = cf:Lerp(goal, eased)
end)

-- ===== BRAZOS / MANOS APUNTAN A LA CABEZA =====
local armState = {}

local function findShoulders(char)
	local list = {}
	local rUA = char:FindFirstChild("RightUpperArm")
	local lUA = char:FindFirstChild("LeftUpperArm")
	if rUA and lUA then -- R15
		local r = rUA:FindFirstChild("RightShoulder")
		local l = lUA:FindFirstChild("LeftShoulder")
		if r then table.insert(list, { joint = r, r6 = false, sign = 1 }) end
		if l then table.insert(list, { joint = l, r6 = false, sign = 1 }) end
	else -- R6
		local torso = char:FindFirstChild("Torso")
		if torso then
			local r = torso:FindFirstChild("Right Shoulder")
			local l = torso:FindFirstChild("Left Shoulder")
			if r then table.insert(list, { joint = r, r6 = true, sign = 1 }) end
			if l then table.insert(list, { joint = l, r6 = true, sign = -1 }) end
		end
	end
	return list
end

local function applyArmPitch(char, pitch)
	for _, info in ipairs(findShoulders(char)) do
		local j = info.joint
		local st = armState[j]
		if not st then
			st = {}
			armState[j] = st
		end
		if st.last == nil or j.C0 ~= st.last then
			st.orig = j.C0
		end
		local rot
		if info.r6 then
			rot = CFrame.Angles(0, 0, pitch * info.sign)
		else
			rot = CFrame.Angles(pitch, 0, 0)
		end
		local new = st.orig * rot
		j.C0 = new
		st.last = new
	end
end

local function restoreArms()
	for j, st in pairs(armState) do
		if j.Parent and st.orig and st.last and j.C0 == st.last then
			j.C0 = st.orig
		end
		armState[j] = nil
	end
end

RunService:BindToRenderStep("GUIXFREE_AimArms", ARMS_PRIORITY, function()
	local active = aimbotWants()
	if not ARMS_AIM or not active or not aimTargetHead then
		if next(armState) ~= nil then restoreArms() end
		return
	end
	local myChar = getChar(player)
	if not myChar then return end

	local dir = (aimTargetHead.Position - camera.CFrame.Position)
	if dir.Magnitude < 0.01 then return end
	dir = dir.Unit
	local pitch = math.asin(math.clamp(dir.Y, -1, 1)) * ARM_PITCH_MULT + ARM_PITCH_OFFSET

	applyArmPitch(myChar, pitch)
end)

-- ===== RAGEBOT =====
-- 1) Guarda tu posición y se pega a la espalda del enemigo más cercano
-- 2) Saca el arma con balas y deja apretado el click IZQUIERDO (disparar)
--    y el click DERECHO (apuntar)
-- 3) Cuando el enemigo muere: suelta ambos clicks y vuelve a tu posición original
-- 4) Espera RAGE_NEXT_DELAY y pasa al siguiente
rageStop = function(goHome)
	holdFire(false)
	holdAim(false)
	local _, _, myRoot = getChar(player)
	if goHome and rageOrigin and myRoot then
		myRoot.CFrame = rageOrigin
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
	end
	rageOrigin = nil
	rageTarget = nil
	rageCooldownUntil = os.clock() + RAGE_NEXT_DELAY
end

local lastRageActivate = 0
local lastRageEquip = 0
local fireDebugged = setmetatable({}, { __mode = "k" })

local function debugFire(tool)
	if fireDebugged[tool] then return end
	fireDebugged[tool] = true

	local names = {}
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("LocalScript") or d:IsA("Script") or d:IsA("RemoteEvent")
			or d:IsA("RemoteFunction") or d:IsA("BindableEvent") then
			table.insert(names, d.ClassName .. ": " .. d.Name)
		end
	end
	print(("[GUI X FREE][RageBot] disparando con '%s' (modo '%s'). Contiene: %s"):format(
		tool.Name, RAGE_FIRE_MODE, #names > 0 and table.concat(names, ", ") or "nada"))

	if not tool.Enabled then
		warn("[GUI X FREE][RageBot] '" .. tool.Name .. "' tiene Enabled = false: Activate() no hará nada.")
	end
	if tool.ManualActivationOnly then
		warn("[GUI X FREE][RageBot] '" .. tool.Name .. "' tiene ManualActivationOnly = true: Activate() no hará nada.")
	end
end

connect(RunService.Heartbeat, function()
	if not state.RageBot then return end

	local myChar, myHum, myRoot = getChar(player)
	if not myChar then
		-- Si tú moriste, cancelar todo (no hay a dónde volver)
		if rageTarget or mouseHeld or aimHeld then
			rageOrigin = nil
			rageStop(false)
		end
		return
	end

	if os.clock() < rageCooldownUntil then return end

	-- ¿Murió el objetivo? → soltar ambos clicks y volver a tu sitio
	if rageTarget and not (rageTarget.Parent and getChar(rageTarget)) then
		print("[GUI X FREE][RageBot] objetivo eliminado → suelto clicks y vuelvo a mi posición")
		rageStop(true)
		return
	end

	-- ¿Lo acabas de marcar como IGNORADO en la lista? → soltar clicks, volver y buscar otro objetivo
	if rageTarget and ignored[rageTarget] then
		print("[GUI X FREE][RageBot] " .. rageTarget.Name .. " está ignorado → cambio de objetivo")
		rageStop(true)
		return
	end

	-- Elegir objetivo nuevo y recordar de dónde sales
	if not rageTarget then
		rageTarget = getNearestPlayer()
		if not rageTarget then return end
		rageOrigin = myRoot.CFrame
		print("[GUI X FREE][RageBot] objetivo: " .. rageTarget.Name)
	end

	-- Pegarse a la espalda (otra vez, después de la física)
	stickBehind()

	-- Sacar el arma (arma 1 → arma 2 si se queda sin balas)
	local tool = pickWeapon(myChar)
	if not tool then return end

	-- Cambiando de arma: soltar clicks y volver a apretarlos con la nueva
	if tool.Parent ~= myChar then
		if mouseHeld then holdFire(false) end
		if aimHeld then holdAim(false) end
		if os.clock() - lastRageEquip > 0.05 then
			lastRageEquip = os.clock()
			myHum:EquipTool(tool)
		end
		return
	end

	debugFire(tool)

	-- Click DERECHO apretado (apuntar) y luego click IZQUIERDO apretado (disparar)
	if RAGE_AIM_RIGHT_CLICK and not aimHeld then
		holdAim(true)
	end
	if not mouseHeld then
		holdFire(true)
	end

	-- Refuerzo con Tool:Activate() para armas que usan Tool.Activated
	if RAGE_FIRE_MODE == "hold" then
		if heldTool ~= tool then
			if heldTool then pcall(function() heldTool:Deactivate() end) end
			pcall(function() tool:Activate() end)
			heldTool = tool
		end
	else
		if os.clock() - lastRageActivate >= RAGE_FIRE_INTERVAL then
			lastRageActivate = os.clock()
			pcall(function() tool:Activate() end)
			task.defer(function()
				if tool.Parent then pcall(function() tool:Deactivate() end) end
			end)
		end
	end
end)

-- ===== TRIGGER BOT =====
-- • En cuanto tu mira toca a un jugador vivo (cabeza, cuerpo, brazos... y sin paredes en medio)
--   dispara DIRECTO con Tool:Activate()
-- • Saca el arma con balas (arma 1 → arma 2) si no la tienes en la mano
-- • Cuando la mira se aparta del enemigo (o muere) suelta el disparo con Tool:Deactivate()
-- • Si falla, dice por qué en el Output
local lastSwitch = 0
local lastDbgMsg, lastDbgTime = "", 0
local triggerFiring = false
local triggerTool = nil

local function dbg(msg)
	if not TRIGGER_DEBUG then return end
	if msg ~= lastDbgMsg or os.clock() - lastDbgTime > 3 then
		lastDbgMsg = msg
		lastDbgTime = os.clock()
		print("[GUI X FREE][TriggerBot] " .. msg)
	end
end

-- Suelta el disparo (para que el arma no siga disparando sola cuando ya no hay enemigo)
triggerStop = function()
	if triggerFiring then
		triggerFiring = false
		if triggerTool then
			pcall(function() triggerTool:Deactivate() end)
		end
		triggerTool = nil
	end
end

local function getAimedPlayer(myChar)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { myChar, camera }
	params.IgnoreWater = true

	local pos
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		pos = camera.ViewportSize / 2
	else
		pos = UserInputService:GetMouseLocation()
	end

	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	local result = workspace:Raycast(ray.Origin, ray.Direction * TRIGGER_RANGE, params)
	if not result then
		return nil, "el rayo no golpea nada"
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and result.Instance:IsDescendantOf(p.Character) then
			return p
		end
	end
	return nil, "apuntas a '" .. result.Instance:GetFullName() .. "' (no es un jugador)"
end

connect(RunService.Heartbeat, function()
	if not state.TriggerBot then
		triggerStop()
		return
	end
	-- Mientras el RageBot controla los clicks, el TriggerBot no se mete
	if state.RageBot then return end

	local myChar, myHum = getChar(player)
	if not myChar then
		triggerStop()
		dbg("tu personaje no está vivo")
		return
	end

	-- 1) Cambio automático al quedarse sin balas
	local equipped = myChar:FindFirstChildOfClass("Tool")
	if equipped then
		debugTool(equipped)
		local ammo = getAmmo(equipped)
		if ammo ~= nil and ammo <= 0 and os.clock() - lastSwitch > 0.15 then
			local nextTool = pickWeapon(myChar)
			if nextTool and nextTool ~= equipped then
				lastSwitch = os.clock()
				triggerStop()
				dbg("sin balas en '" .. equipped.Name .. "', cambio a '" .. nextTool.Name .. "'")
				myHum:EquipTool(nextTool)
			end
		end
	end

	-- 2) ¿Estoy apuntando a un jugador vivo? Si no, suelto el disparo
	local target, why = getAimedPlayer(myChar)
	if not target then
		triggerStop()
		dbg("sin objetivo: " .. tostring(why))
		return
	end
	if not getChar(target) then
		triggerStop()
		dbg(target.Name .. " ya está muerto")
		return
	end

	-- 3) Sacar el arma correcta y disparar DIRECTO
	local tool = pickWeapon(myChar)
	if not tool then
		dbg("no encontré ninguna Tool en tu Backpack ni en la mano (¿tu arma es una Tool?)")
		return
	end

	if tool.Parent ~= myChar then
		if os.clock() - lastSwitch > 0.05 then
			lastSwitch = os.clock()
			dbg("sacando '" .. tool.Name .. "'")
			myHum:EquipTool(tool)
		end
		return
	end

	-- Si cambió de arma, soltar la anterior
	if triggerTool and triggerTool ~= tool then
		pcall(function() triggerTool:Deactivate() end)
	end

	dbg("disparando a " .. target.Name .. " con '" .. tool.Name .. "'")
	triggerFiring = true
	triggerTool = tool
	tool:Activate()
end)

