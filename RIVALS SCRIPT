-- ===== RAGEBOT: PEGARSE A LA ESPALDA =====
-- Se ejecuta en cada frame y otra vez tras la física, con la velocidad en 0
-- para que nada te empuje fuera de su espalda.
local function stickBehind()
	if not state.RageBot or not rageTarget then return end
	local _, _, myRoot = getChar(player)
	local _, _, tRoot = getChar(rageTarget)
	if not myRoot or not tRoot then return end

	-- "Detrás" según hacia dónde mira el enemigo, a su misma altura
	local look = Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
	if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
	look = look.Unit

	local pos = tRoot.Position - look * BEHIND_DISTANCE
	local lookAt = Vector3.new(tRoot.Position.X, pos.Y, tRoot.Position.Z)

	myRoot.CFrame = CFrame.lookAt(pos, lookAt)
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero
end

RunService:BindToRenderStep("GUIXFREE_RageStick", Enum.RenderPriority.Character.Value + 1, stickBehind)

