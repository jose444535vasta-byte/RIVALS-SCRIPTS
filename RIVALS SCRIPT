-- ===== DISPARO DE LOS TOOLS (en segundo plano: NUNCA bloquea el panel) =====
-- =====================================================================
task.spawn(function()
	local mouse = player:GetMouse()
	local shootRemote = ReplicatedStorage:WaitForChild(SHOOT_REMOTE_NAME, 15)
	if not shootRemote then
		warn("[GUI X FREE] no encontré '" .. SHOOT_REMOTE_NAME .. "' (el panel funciona igual). "
			.. "Pega este mismo código también como Script en ServerScriptService para que disparen los Tools.")
		return
	end

	local hooked = setmetatable({}, { __mode = "k" })

	local function isGun(tool)
		if #GUN_TOOL_NAMES == 0 then return true end
		for _, n in ipairs(GUN_TOOL_NAMES) do
			if tool.Name == n then return true end
		end
		return false
	end

	local function hookTool(tool)
		if hooked[tool] or not tool:IsA("Tool") or not isGun(tool) then return end
		hooked[tool] = true

		local holding, equipped = false, false

		tool.Equipped:Connect(function() equipped = true end)
		tool.Unequipped:Connect(function()
			equipped = false
			holding = false
		end)
		tool.Activated:Connect(function()
			if holding then return end
			holding = true
			while holding and equipped do
				shootRemote:FireServer((mouse.Hit.Position - camera.CFrame.Position).Unit)
				task.wait(GUN_FIRE_INTERVAL)
			end
		end)
		tool.Deactivated:Connect(function() holding = false end)
	end

	local function watch(container)
		for _, c in ipairs(container:GetChildren()) do hookTool(c) end
		container.ChildAdded:Connect(hookTool)
	end

	local function onCharacter(char)
		watch(char)
		local bp = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 10)
		if bp then watch(bp) end
	end

