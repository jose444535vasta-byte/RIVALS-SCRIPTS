connect(closeBtn.MouseButton1Click, function()
	local fpsWasOn = state.FPSBoost
	local rageWasOn = state.RageBot
	for k in pairs(state) do state[k] = false end

	-- Soltar clicks y volver a tu posición si el RageBot estaba en medio de un objetivo
	if rageWasOn then rageStop(true) end
	holdFire(false)
	holdAim(false)

	if fpsWasOn then setFPSBoost(false) end

	restoreArms()
	local _, myHum = getChar(player)
	if autoRotateBackup ~= nil and myHum then
		myHum.AutoRotate = autoRotateBackup
		autoRotateBackup = nil
	end

	RunService:UnbindFromRenderStep("GUIXFREE_Aimbot")
	RunService:UnbindFromRenderStep("GUIXFREE_AimArms")
	RunService:UnbindFromRenderStep("GUIXFREE_RageStick")
	for _, c in ipairs(connections) do c:Disconnect() end
	table.clear(connections)
	gui:Destroy()
end)
