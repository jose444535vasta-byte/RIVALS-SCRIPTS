-- Apaga CanCollide de las partes de tu personaje mientras esté encendido y lo devuelve al apagarlo.
-- (Tu personaje sigue pisando el suelo con normalidad; solo atraviesa paredes y objetos.)
local noclipChanged = {}

restoreNoclip = function()
	for part in pairs(noclipChanged) do
		if part.Parent then part.CanCollide = true end
		noclipChanged[part] = nil
	end
end

